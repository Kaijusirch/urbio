{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (TS5) for Vite */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting (keep relaxed as in original) */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    /* Path aliases used by Vite */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* App typings (do not leak test globals here) */
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "vite-env.d.ts"
  ]
}
